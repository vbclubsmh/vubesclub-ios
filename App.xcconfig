PRODUCT_NAME = VubesClubApp
PRODUCT_BUNDLE_IDENTIFIER = com.vubesclub.mobile
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// Swift 6 dil modu, SwiftUI'nin yeni iOS sürümlerinde arka planda çizdiği App.body kapanışlarında
// çalışma zamanı aktör denetimi (_dispatch_assert_queue_fail) ekler ve uygulamayı aralıklı olarak çökertir.
// Swift 5 modu bu çalışma zamanı denetimini kaldırır; derleme zamanı eşzamanlılık uyarıları açık kalır.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = AppInfo.plist
INFOPLIST_KEY_CFBundleDisplayName = Vubes Club
ALWAYS_SEARCH_USER_PATHS = NO

// API origin. Debug targets a developer Mac (override in Local.xcconfig); Release targets production.
VUBES_API_BASE_URL[config=Debug] = https:/$()/api.vubesclub.com
VUBES_API_BASE_URL[config=Release] = https:/$()/api.vubesclub.com
// Shows the fixed test code on the verification screen while the server accepts it (Identity:AllowFixedOtp).
VUBES_OTP_HINT = YES
#include? "Local.xcconfig"
